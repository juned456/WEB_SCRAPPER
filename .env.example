# Docker host port and application timezone
HOST_PORT=3002
TZ=Asia/Kolkata

# Monitoring
POLL_INTERVAL_SECONDS=300
MAX_SCREENER_PAGES=10
SCREENER_URL=https://www.screener.in/screens/3285703/techno-funda-screener/
NSE_DAILY_REPORTS_URL=https://www.nseindia.com/api/daily-reports?key=CM

# Mainboard IPO screener (rolling last 3 years, SME excluded)
IPO_SCREENER_URL=https://www.screener.in/ipo/recent/?order=desc&sort=listdate
IPO_MAX_PAGES=50
IPO_POLL_INTERVAL_HOURS=24
IPO_COMPLIANCE_REFRESH_DAYS=7

# Optional Musaffa overrides
MUSAFFA_API_KEY=
MUSAFFA_BASE_URL=

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=
NOTIFICATION_DEEP_LINK=
